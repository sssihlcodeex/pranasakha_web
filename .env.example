# =========================================================
# PRANASAKHA - LOCAL DEVELOPMENT BACKEND
# Copy this file to .env for local development.
# =========================================================

NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pranasakha
DATABASE_SSL=false
DB_POOL_MAX=15
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:4000
PUBLIC_WEB_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
PROFILE_PICTURE_DIR=uploads/profile-pictures
MAX_UPLOAD_BYTES=10485760
RESEND_API_KEY=
EMAIL_FROM=PRANASAKHA <noreply@example.org>
NOTIFICATION_EMAIL_LOOKUP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:4000/api/auth/microsoft/callback
OAUTH_CA_FILE=

# For a Vite build using the local API:
# VITE_API_BASE_URL=http://localhost:4000/api
